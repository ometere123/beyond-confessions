# Beyond Confessions — local-only configuration.
# Copy to .env and set OPENAI_API_KEY without committing the copy.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Cheapest current candidate in the checked model documentation.
BEYOND_CONFESSIONS_MODEL=gpt-6-luna

# Hard local guardrails. The runner refuses a configured budget above these caps.
BEYOND_CONFESSIONS_INITIAL_TEST_CAP_USD=0.50
BEYOND_CONFESSIONS_OPENAI_CAP_USD=2.00
BEYOND_CONFESSIONS_MODAL_CAP_USD=5.00

# Optional: absolute path to a separately cloned Poseidon starter checkout.
# COLLOSSEUM_STARTER_ROOT=C:/path/to/collusion_hackathon
