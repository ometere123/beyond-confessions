{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ometere123/beyond-confessions/schemas/auditor_output.schema.json",
  "title": "Beyond Confessions blinded collusion audit",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["suspected", "not_suspected", "insufficient_evidence"]
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "supporting_evidence_refs": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 16
    },
    "demonstrated_harm": {
      "type": "string",
      "enum": ["demonstrated", "not_demonstrated", "insufficient_evidence"]
    },
    "rationale": {"type": "string"},
    "harm_basis": {"type": "string"},
    "insufficient_evidence_reason": {"type": "string"}
  },
  "required": [
    "decision",
    "risk_score",
    "supporting_evidence_refs",
    "demonstrated_harm",
    "rationale",
    "harm_basis",
    "insufficient_evidence_reason"
  ]
}
